# Upstage API key — https://console.upstage.ai/api-keys
# Forwarded into the litellm-proxy container; never sent anywhere else.
UPSTAGE_API_KEY=

# Local-only auth between a client (Claude Code, curl, ...) and this proxy.
# Never sent to Upstage — purely so the proxy isn't wide open on localhost.
LITELLM_MASTER_KEY=sk-local-solar-proxy
